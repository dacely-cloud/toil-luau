local M=require("./Model")
local s=M.new();local now=86400*20000+100
local d=M.refreshDaily(s,now)
assert(not M.claimDaily(s,"clicks",now))
M.recordDaily(s,"clicks",49,now);assert(not M.claimDaily(s,"clicks",now))
M.recordDaily(s,"clicks",1,now);s.economy.energy=0
assert(M.claimDaily(s,"clicks",now));assert(s.economy.xp==5 and s.economy.energy==10)
assert(not M.claimDaily(s,"clicks",now))
for _,id in {"jobs","buildings"} do M.recordDaily(s,id,999,now);assert(M.claimDaily(s,id,now)) end
assert(s.economy.inventory.flour==1 and s.economy.xp==15)
assert(not M.claimDaily(s,"buildings",now))
local restored=M.new();M.restoreEconomy(restored,M.snapshot(s))
assert(not M.claimDaily(restored,"clicks",now))
assert(restored.economy.inventory.flour==1)
s.earned=M.starGoal(1);assert(M.advancedAction(s,"ascend"));assert(not M.claimDaily(s,"jobs",now))
assert(M.refreshDaily(s,now-100).claimed.jobs,"backward clock cannot reset goals")
M.refreshDaily(s,now+86400);assert(not s.economy.daily.claimed.jobs)
assert(not M.claimDaily(s,"jobs",now+86400))
M.recordDaily(s,"jobs",3,now+86400);assert(M.claimDaily(s,"jobs",now+86400))
assert(s.economy.inventory.flour==1,"partial next day cannot repeat completion bonus")
local old=M.new();M.restoreEconomy(old,{economy={xp=4000}})
assert(not old.economy.daily);assert(not M.claimDaily(old,"clicks",now))
M.restoreDaily(old,{day=20000,progress={clicks=math.huge,jobs=0/0},claimed={clicks=true,jobs=true}})
assert(not old.economy.daily.claimed.clicks and not old.economy.daily.claimed.jobs)
M.recordDaily(old,"clicks",0/0,now);assert(old.economy.daily.progress.clicks==0)
assert(not M.claimDaily(old,{},now))
-- Passive and offline production must never count as manual play.
local idle=M.new();M.refreshDaily(idle,now);idle.buildings[1]=10000;M.tick(idle,28800,true)
assert((idle.economy.daily.progress.clicks or 0)==0)
print("PASS daily goals: bounded progress/rewards, all-three bonus, claim replay, saves, UTC rollover, rebirth, bad data and no passive credit")
