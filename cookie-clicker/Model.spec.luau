local Model = require("./Model")
local passed = 0
local function test(name, callback)
	callback()
	passed += 1
	print("PASS " .. name)
end
test("new bakery starts empty and a click earns exactly one", function()
	local s = Model.new()
	assert(s.cookies == 0 and Model.cps(s) == 0)
	assert(Model.click(s) == 1)
	assert(s.cookies == 1 and s.earned == 1 and s.handmade == 1 and s.clicks == 1)
	assert(s.achievements["Wake and bake"])
end)
test("cannot buy without funds", function()
	local s = Model.new()
	assert(not Model.trade(s, 1, 1, false))
	assert(s.cookies == 0 and s.buildings[1] == 0)
end)
test("cursor price increases and passive income uses elapsed seconds", function()
	local s = Model.new()
	s.cookies = 15
	assert(Model.trade(s, 1, 1, false))
	assert(s.cookies == 0 and Model.price(s, 1, 1, false) == 18)
	Model.tick(s, 10)
	assert(s.cookies == 1 and s.played == 10 and Model.cps(s) == 0.1)
end)
test("bulk quote and unit transaction rounding match browser behavior", function()
	local s = Model.new()
	assert(Model.price(s, 1, 10, false) == 305)
	s.cookies = 308
	assert(Model.trade(s, 1, 10, false))
	assert(s.buildings[1] == 10 and s.cookies == 0)
end)
test("bulk buy purchases affordable subset", function()
	local s = Model.new()
	s.cookies = 33
	assert(Model.trade(s, 1, 100, false))
	assert(s.buildings[1] == 2 and s.cookies == 0)
end)
test("bulk sale is bounded by owned count and uses current unit price", function()
	local s = Model.new()
	s.buildings[1] = 10
	assert(Model.trade(s, 1, 100, true))
	assert(s.buildings[1] == 0 and s.cookies == 84)
	assert(not Model.trade(s, 1, 1, true))
end)
test("upgrade is locked until eligible and cannot be repurchased", function()
	local s = Model.new()
	s.cookies = 1000
	assert(not Model.buyUpgrade(s, "fingers"))
	s.buildings[1] = 1
	assert(Model.buyUpgrade(s, "fingers"))
	assert(s.cookies == 900 and math.abs(Model.clickPower(s)-2.01)<1e-8 and Model.cps(s) == 0.2)
	assert(not Model.buyUpgrade(s, "fingers"))
end)
test("invalid actions cannot corrupt economy", function()
	local s = Model.new()
	for _, q in { -1, 0, 0.5, math.huge, 0/0 } do assert(not Model.trade(s, 1, q, false)) end
	assert(not Model.trade(s, 21, 1, false))
	Model.tick(s, -5); Model.tick(s, math.huge); Model.award(s, 0/0)
	assert(s.cookies == 0 and s.played == 0)
end)
test("snapshots do not share mutable economy tables", function()
	local s = Model.new()
	local snap = Model.snapshot(s)
	snap.buildings[1] = 100
	snap.upgrades.fingers = true
	snap.achievements.fake = true
	assert(s.buildings[1] == 0 and not s.upgrades.fingers and not s.achievements.fake)
end)
test("twenty building definitions are available", function()
	assert(#Model.Buildings == 20)
	local s = Model.new()
	s.buildings[20] = 1
	assert(Model.cps(s) == 510e12)
	assert(Model.Buildings[20].price == 540e24)
end)
test("every building has multiple upgrade tiers",function()
	for i=1,20 do local count=0;for _,u in Model.Upgrades do if u.building==i then count+=1 end end;assert(count>=5)end
end)
test("golden cookies expire and cannot be collected twice",function()
	local s=Model.new();s.played=75;Model.goldenTick(s);local id=s.goldenId
	assert(Model.collectGolden(s,id));assert(s.cookies==25);assert(Model.collectGolden(s,id)==nil)
	s.played=s.goldenAt;Model.goldenTick(s);s.played=s.goldenUntil;assert(Model.collectGolden(s,s.goldenId)==nil)
end)
test("temporary double baking ends exactly at its boundary",function()
	local s=Model.new();s.buildings[2]=1;s.frenzyUntil=10
	Model.tick(s,15);assert(s.cookies==25);assert(Model.cps(s)==1)
end)
test("fresh starts grant chips once and retain permanent progress",function()
	local s=Model.new();s.earned=1e12;s.cookies=1e12;s.buildings[1]=20;s.lumps=3;s.levels[1]=2
	assert(Model.advancedAction(s,"ascend"));assert(s.prestige==1 and s.chips==1 and s.cookies==0 and s.buildings[1]==0 and s.lumps==3 and s.levels[1]==2)
	assert(not Model.advancedAction(s,"ascend"));assert(Model.advancedAction(s,"heavenly","baking"));assert(s.chips==0 and s.heavenly.baking)
	assert(not Model.advancedAction(s,"heavenly","baking"))
end)
test("sugar growth and levels use bounded costs",function()
	local s=Model.new();s.earned=1e6;s.buildings[1]=1;Model.tick(s,20*3600);assert(s.lumps==1)
	assert(Model.advancedAction(s,"level",1));assert(s.levels[1]==1 and s.lumps==0);assert(not Model.advancedAction(s,"level",1))
	assert(math.abs(Model.cps(s)-.101*Model.milkMultiplier(s))<.00001)
end)
test("buddies hold cookies and return a one-time bonus",function()
	local s=Model.new();s.buildings[2]=10;assert(Model.advancedAction(s,"buddies"));Model.tick(s,10)
	assert(s.cookies==95 and s.buddyBank==5);assert(Model.advancedAction(s,"collectBuddies"));assert(s.cookies==100.5 and s.buddyBank==0)
	assert(not Model.advancedAction(s,"collectBuddies"))
end)
test("garden harvest waits and its bonus expires",function()
	local s=Model.new();s.buildings[3]=1;s.lumps=1;assert(Model.advancedAction(s,"plant"));assert(not Model.advancedAction(s,"harvest"))
	Model.tick(s,60);assert(Model.advancedAction(s,"harvest"));assert(math.abs(Model.cps(s)-8.4)<.0001);Model.tick(s,601);assert(Model.cps(s)==8)
end)
test("market trades charge real prices and cannot sell missing stock",function()
	local s=Model.new();s.buildings[6]=1;s.cookies=1000;local price=Model.stockPrice(s,1)
	assert(Model.advancedAction(s,"stockBuy",1));assert(s.cookies==1000-price and s.stocks[1]==1)
	assert(Model.advancedAction(s,"stockSell",1));assert(s.stocks[1]==0 and s.cookies==1000-price+math.floor(price*.9))
	assert(not Model.advancedAction(s,"stockSell",1))
end)
test("temple cooldown and magic costs are enforced",function()
	local s=Model.new();s.buildings[7]=1;s.buildings[8]=1
    local before=Model.clickPower(s)
	assert(Model.advancedAction(s,"spirit","clicking"));assert(not Model.advancedAction(s,"spirit","baking"));assert(math.abs(Model.clickPower(s)-before*1.1)<1e-7)
	assert(not Model.advancedAction(s,"spell","lucky"));Model.tick(s,40);assert(Model.advancedAction(s,"spell","lucky"));assert(s.magic==0 and s.goldenUntil>s.played)
end)
test("season hunts award a bonus at five collected cookies",function()
	local s=Model.new();assert(Model.advancedAction(s,"season","winter"))
	for i=1,5 do s.goldenId=i;s.goldenUntil=s.played+10;assert(Model.collectGolden(s,i))end
	assert(s.seasonCookies==5 and s.cookies>=500)
end)
test("hunt feedback follows each five-cookie reward and pauses preserve progress",function()
    local s=Model.new();Model.advancedAction(s,"season","winter")
    for i=1,10 do
        Model.spawnGolden(s)
        local message=Model.collectGolden(s,s.goldenId)
        assert((string.find(message,"Hunt reward:",1,true)~=nil)==(i%5==0))
        local paid=s.cookies
        assert(not Model.collectGolden(s,s.goldenId) and s.cookies==paid)
    end
    Model.advancedAction(s,"season","none")
    Model.spawnGolden(s);Model.collectGolden(s,s.goldenId)
    assert(s.seasonCookies==10)
    Model.advancedAction(s,"season","spring")
    Model.spawnGolden(s);Model.collectGolden(s,s.goldenId)
    assert(s.seasonCookies==11)
end)
test("lucky spells reset the falling cookie and invalidate old claims",function()
    local s=Model.new();s.buildings[8]=1;s.magic=100;s.played=75
    Model.goldenTick(s);local previous=s.goldenId
    s.played+=100
    assert(Model.advancedAction(s,"spell","lucky"))
    assert(s.magic==60 and s.goldenId==previous+1 and s.goldenStarted==s.played)
    assert(s.goldenDuration>=8 and s.goldenDuration<=16)
    assert(s.goldenUntil==s.played+s.goldenDuration and s.goldenX>=.1 and s.goldenX<=.9)
    assert(s.goldenAt>s.goldenUntil)
    Model.goldenTick(s);assert(s.goldenId==previous+1, "scheduled spawn must not replace the spell immediately")
    assert(not Model.collectGolden(s,previous))
    assert(Model.collectGolden(s,s.goldenId));assert(not Model.collectGolden(s,s.goldenId))
end)
test("ascension preserves saved audio preferences",function()
    local s=Model.new();s.earned=1e12;s.soundEnabled=false;s.soundVolume=30;s.reducedMotion=true
    assert(Model.advancedAction(s,"ascend"))
    assert(s.soundEnabled==false and s.soundVolume==30 and s.reducedMotion)
end)
test("building levels cannot exceed their persistence limit",function()
    local s=Model.new();s.buildings[1]=1;s.levels[1]=99;s.lumps=1000
    assert(Model.advancedAction(s,"level",1));assert(s.levels[1]==100 and s.lumps==900)
    assert(not Model.advancedAction(s,"level",1));assert(s.levels[1]==100 and s.lumps==900)
end)
test("ascension does not reuse collectible identifiers",function()
    local s=Model.new();s.buildings[2]=10
    assert(Model.advancedAction(s,"buddies"));local oldWrinkler=s.wrinklers[1].id
    Model.spawnGolden(s);local oldGolden=s.goldenId
    s.earned=1e12;assert(Model.advancedAction(s,"ascend"))
    assert(#s.wrinklers==0 and s.goldenUntil==0)
    s.buildings[2]=10;assert(Model.advancedAction(s,"buddies"));Model.spawnGolden(s)
    assert(s.wrinklers[1].id>oldWrinkler and s.goldenId>oldGolden)
    assert(not Model.advancedAction(s,"popWrinkler",oldWrinkler))
    assert(not Model.collectGolden(s,oldGolden))
end)
print(string.format("Cookie Clicker: %d passed", passed))
