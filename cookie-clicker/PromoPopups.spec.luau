local Promo=require("./PromoPopups")
local p=Promo.new(0)
assert(p.step(59,true)==nil)
assert(p.step(60,false)==nil,"busy UI must defer")
assert(p.step(65,true)=="friends")
assert(p.step(74,true)=="friends")
assert(p.step(75,true)==nil,"auto-dismiss after ten seconds")
assert(p.step(254,true)==nil)
assert(p.step(255,true)=="shop")
p.dismiss(256)
assert(p.step(435,true)==nil,"closing starts cooldown")
assert(p.step(436,true)=="starter")
assert(p.step(437,false)==nil,"opening a menu hides the offer")
assert(p.step(10000,true)==nil,"no repeat spam after session offers")
print("PASS promos: busy deferral, expiry, dismissal cooldown, no queue and bounded session offers")
