local M=require("./Model")
local s=M.new();s.economy.energy=20;s.economy.stamina=30;s.economy.xp=M.jobLevelXp(2)
local r=M.claimLevelReward(s)
assert(r.level==2 and r.energy==10 and r.stamina==5 and r.item=="spatula")
assert(s.economy.energy==30 and s.economy.stamina==35)
assert(not M.claimLevelReward(s))
s.economy.xp=M.jobLevelXp(5);r=M.claimLevelReward(s)
assert(r.energy==30 and r.stamina==15 and r.item=="milk")
s.economy.energy=99;s.economy.stamina=99;s.economy.xp=M.jobLevelXp(6)
r=M.claimLevelReward(s);assert(r.energy==1 and r.stamina==1)
local restored=M.new();M.restoreEconomy(restored,M.snapshot(s));assert(not M.claimLevelReward(restored))
local legacy=M.snapshot(s);legacy.economy.rewardedLevel=nil
M.restoreEconomy(restored,legacy);assert(not M.claimLevelReward(restored))
s.earned=M.starGoal(1);assert(M.advancedAction(s,"ascend"));assert(not M.claimLevelReward(s))
local b=M.new();local cps,tap=M.cps(b),M.clickPower(b);b.cookies=15
assert(M.trade(b,1,1,false))
assert(M.purchaseProgress(b,cps,tap)=="+0.1 cookies/sec")
b.cookies=100;cps,tap=M.cps(b),M.clickPower(b);assert(M.buyUpgrade(b,"fingers"))
assert(M.purchaseProgress(b,cps,tap):find("per tap",1,true))
assert(M.purchaseProgress(b,M.cps(b),M.clickPower(b))=="")
print("PASS level gifts: one-time, bounded resources, bulk levels, old saves, rebirth preservation and actual purchase gain feedback")
