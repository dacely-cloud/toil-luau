local Model=require("./Model")
local owner,helper,thief=Model.new(),Model.new(),Model.new()
owner.economy.jar=10000
assert(not Model.startFundraiser(owner,0/0,100))
assert(Model.startFundraiser(owner,1,100))
assert(owner.economy.jar==9500 and owner.economy.charity.endsAt==1900)
assert(not Model.startFundraiser(owner,2,100))
assert(not Model.claimFundraiser(owner,1899))
assert(not Model.charityAction(owner,owner,1,1,"help",200))
assert(Model.charityAction(helper,owner,2,1,"help",200))
assert(helper.cookies==50 and helper.economy.xp==20 and helper.economy.stamina==95 and owner.economy.charity.pot==850)
assert(not Model.charityAction(helper,owner,2,1,"help",201))
local before=owner.economy.charity.pot+thief.cookies
assert(Model.charityAction(thief,owner,3,1,"steal",200))
assert(owner.economy.charity.pot+thief.cookies==before and thief.economy.stamina==90)
assert(not Model.charityAction(thief,owner,3,1,"steal",201))
for id=4,20 do Model.charityAction(Model.new(),owner,id,1,"steal",200) end
assert(owner.economy.charity.stolen==125 and owner.economy.charity.pot==725)
local restored=Model.new();Model.restoreSocial(restored,Model.snapshot(owner))
assert(restored.economy.charity.helpers['2'] and restored.economy.charity.thieves['3'])
assert(not Model.charityAction(helper,restored,2,1,"help",201))
assert(not Model.charityAction(helper,owner,2,1,"help",1900))
assert(Model.claimFundraiser(owner,1900))
assert(owner.cookies==725 and owner.earned==225)
assert(not Model.claimFundraiser(owner,1901))
print("PASS charity duration, jar funding, help rewards, stamina, replay rejection, conservation, theft cap, save restore and one-time claim")
