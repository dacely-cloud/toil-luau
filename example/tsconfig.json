{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@toil/react",
    "module": "commonjs",
    "moduleDetection": "force",
    "moduleResolution": "node",
    "noLib": true,
    "outDir": "out",
    "resolveJsonModule": true,
    "rootDir": "src",
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": false,
    "target": "es2020",
    "typeRoots": [
      "node_modules/@rbxts",
      "node_modules/@toil",
      "../type-shims",
      "node_modules/@toil-luau"
    ],
    "types": [
      "rbxts",
      "toil-shims",
      "js-globals"
    ]
  },
  "include": [
    "src"
  ]
}
